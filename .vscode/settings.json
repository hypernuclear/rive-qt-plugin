{
  // CMake Tools handles Qt discovery via the Qt kit you select
  // (qt-cpp extension injects qt.toolchain.cmake). No hardcoded Qt path here.
  "cmake.configureOnOpen": true,
  "cmake.buildBeforeRun": true,

  "C_Cpp.default.compilerPath": "/usr/bin/clang++",
  "C_Cpp.errorSquiggles": "enabled"
}
