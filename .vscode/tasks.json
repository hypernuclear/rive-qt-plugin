{
  // Manual build tasks. CMake Tools handles configure via the selected
  // Qt kit (no Qt path hardcoded here) and auto-builds before launch
  // (cmake.buildBeforeRun). These tasks are for explicit F1 → Run Task
  // invocation when you want to build without launching.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Viewer",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "build", "--target", "rive_viewer"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Clean Build",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "build", "--target", "clean"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
