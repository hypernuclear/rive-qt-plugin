# Build output
/build/
/build-*/
/out/

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json
.cmake/
.cache/
.claude/
# Per-developer presets — machine-specific paths (Qt prefix, etc.). Each
# dev creates their own; it inherits the committed presets in
# CMakePresets.json. Never committed.
CMakeUserPresets.json

# IDEs — keep .vscode/ tracked so launch/tasks configs ship with the repo.
.idea/
.vs/
*.user
*.user.*
.qtcreator/
.qmlls.ini

# macOS
.DS_Store

# Editor temp
*.swp
*~

# Submodules — contents ignored so local patches don't get accidentally
# tracked. The submodule itself is added via .gitmodules / `git submodule`.
third_party/**/*
third_party/rive-runtime
